# Optional. Required only when using the Upstash connector against a real account.
UPSTASH_QSTASH_TOKEN=replace-with-a-qstash-token
UPSTASH_QSTASH_URL=https://qstash.upstash.io
# Required to accept SDK evidence at POST /api/webhooks/evidence.
# Generate a high-entropy random value; never reuse the Upstash token.
DEADWIRE_INGEST_SECRET=replace-with-a-random-webhook-secret
# Optional server-side integration credentials.
GITHUB_TOKEN=replace-with-a-fine-grained-read-only-token
